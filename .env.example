# Everlore API + worker — copy to .env and fill in values.
# Bun loads .env automatically; see src/config/env.ts for parsing.

# -----------------------------------------------------------------------------
# Required for production (local dev falls back if unset — see env.ts warnings)
# -----------------------------------------------------------------------------

# Symmetric secret for JWT sign/verify (use a long random string in production)
JWT_SECRET=

# MongoDB connection (indexes are created on first connect)
MONGODB_URI=mongodb://localhost:27017/everlore

# Redis — HTTP API, WebSocket pub/sub, BullMQ queues, rate limits, session cache
REDIS_URL=redis://localhost:6379

# OpenAI — embeddings, default chat when not using OpenRouter
OPENAI_API_KEY=

# Pinecone — vector index for lore RAG and memory retrieval
PINECONE_API_KEY=
# Index name in your Pinecone project (vectors upserted per-namespace as lore_{templateId}, mem_{instanceId})
PINECONE_INDEX=nexus-memories

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# HTTP port (default 3000)
PORT=3000

# Comma-separated browser origins for CORS (Flutter/web clients)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8080

# OpenRouter — alternate LLM provider (used by worker/model router when configured)
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Operational notes (not read by this server yet)
# -----------------------------------------------------------------------------

# Google Sign-In: the /auth/google route currently decodes the ID token payload only.
# For production, verify tokens (e.g. google-auth-library) and optionally set:
# GOOGLE_CLIENT_ID=
