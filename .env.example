# Everlore API + worker — copy to .env and fill in values.
# Bun loads .env automatically; see src/config/env.ts for parsing.
# Canonical docs: everlore-docs/server/CONFIGURATION.md

# -----------------------------------------------------------------------------
# Required for production (local dev falls back if unset — see env.ts warnings)
# -----------------------------------------------------------------------------

# Symmetric secret for JWT sign/verify (use a long random string in production)
JWT_SECRET=

# MongoDB connection (indexes are created on first connect)
MONGODB_URI=mongodb://localhost:27017/everlore

# Redis — HTTP API, WebSocket pub/sub, BullMQ queues, rate limits, session cache
REDIS_URL=redis://localhost:6379

# OpenAI — embeddings; also used when CHEAP_RANK_MODEL is an OpenAI model id
OPENAI_API_KEY=

# Pinecone — vector index for lore RAG and memory retrieval
PINECONE_API_KEY=
# Namespaces: lore_{templateId}, mem_{instanceId}, sum_{instanceId}
PINECONE_INDEX=nexus-memories

# -----------------------------------------------------------------------------
# Server / CORS
# -----------------------------------------------------------------------------

PORT=3000
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# LLM providers & models
# -----------------------------------------------------------------------------

# OpenRouter — narration, images, TTS, most chat models
OPENROUTER_API_KEY=

# Prefer providers whose recent p90 latency is within this target (seconds).
# Routing preference only; 0 disables.
OPENROUTER_PREFERRED_P90_LATENCY_SECONDS=3

# Narration defaults (prose-only). Templates may override via model_preferences.
NARRATION_SFW_MODEL=deepseek/deepseek-v3.2
NARRATION_NSFW_MODEL=thedrummer/cydonia-24b-v4.1
# Used only after the primary narrator receives a pre-stream HTTP 429. Keep the
# NSFW list mature-capable; do not send a mature turn to an SFW fallback.
NARRATION_SFW_FALLBACK_MODELS=mistralai/mistral-small-3.2-24b-instruct,meta-llama/llama-3.1-70b-instruct,mistralai/mistral-nemo
NARRATION_NSFW_FALLBACK_MODELS=thedrummer/unslopnemo-12b,aion-labs/aion-2.0

# OpenRouter image + authoring + TTS
IMAGE_MODEL=bytedance-seed/seedream-4.5
AUTHORING_MODEL=google/gemini-2.5-flash-lite
TTS_MODEL=hexgrad/kokoro-82m

# Cheap aux model for optional RAG re-rank / borderline NSFW intent judge.
# Prefer a non-Claude id. gpt-4o-mini routes via the OpenAI key.
CHEAP_RANK_MODEL=gpt-4o-mini
RAG_RERANK_ENABLED=false
NSFW_INTENT_DEFER_ENABLED=false

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------

# Google Sign-In — Web OAuth client ID (token audience). Flutter must request an ID token for this client.
FIREBASE_PROJECT_ID=everlore-app
GOOGLE_CLIENT_ID=

# Twilio Verify — use AC_MOCK_SID for local mock OTP (accepted code 123456)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Dev only: skip OTP send/verify Redis rate limits. MUST be false in production.
DISABLE_OTP_RATE_LIMIT=false

# -----------------------------------------------------------------------------
# Admin suite (/admin/*) — HTTP Basic Auth
# Leave both unset to disable admin API (returns 503).
# -----------------------------------------------------------------------------

ADMIN_USERNAME=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Throughput (BullMQ worker + API rate limits)
# -----------------------------------------------------------------------------

# Simultaneous story turns one worker process runs at once
GENERATION_CONCURRENCY=3
# Max new generation jobs started per minute per worker process
GENERATION_RATE_MAX=10
# Max chat/continue/side_chat/replay actions per user per 60s
CHAT_RATE_MAX=10
# Max world template creates per user per 24h
TEMPLATE_CREATE_RATE_MAX=5

# -----------------------------------------------------------------------------
# Billing / Story Ink / Google Play
# See everlore-docs/server/BILLING.md and everlore-server/BILLING_PLAY_SETUP.md
# -----------------------------------------------------------------------------

# When false, reserve/settle still run but insufficient funds do not block play.
# Production automatically enforces billing once Google Play credentials below
# are configured, even if this flag is left false.
BILLING_ENFORCEMENT_ENABLED=false
# Local/internal simulated checkout only. Hard-blocked when NODE_ENV=production.
BILLING_SIMULATION_ENABLED=false

GOOGLE_PLAY_PACKAGE_NAME=
# Full service-account JSON as a single-line string (Android Publisher API)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# RTDN push subscription OIDC audience + sender email
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# -----------------------------------------------------------------------------
# AWS S3 + CloudFront (generated media: covers, avatars, backgrounds)
# Bucket is private; serve via CDN only. AWS SDK also reads AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY from the environment (not parsed in env.ts).
# -----------------------------------------------------------------------------

AWS_REGION=ap-south-1
S3_BUCKET=your-media-bucket
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret
CDN_BASE_URL=https://your-distribution.cloudfront.net

# Seed universal fallback cover:
#   bun run seed:default-cover  →  <CDN_BASE_URL>/media/defaults/everlore-cover.webp

# Google Play reviewer sign-in. Both must be set or the path is inert.
# Play reviewers cannot receive our OTP SMS, so this is the only credential we
# can give them. REVIEW_DEMO_OTP must be exactly six digits and not guessable;
# rotate it like a password and unset both once a reviewer can sign in unaided.
REVIEW_DEMO_PHONE=
REVIEW_DEMO_OTP=
